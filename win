Write-Host "ARES Power Plan Configurator" -ForegroundColor Cyan
Write-Host "============================" -ForegroundColor Cyan
Write-Host ""
Write-Host "Select preset:"
Write-Host "1. Gaming (Maximum Performance)"
Write-Host "2. Balanced"
Write-Host "3. Power Saver"
Write-Host ""

$choice = Read-Host "Enter choice (1-3)"

$existingPlan = powercfg -list | Select-String "ARES"
if ($existingPlan) {
    Write-Host "Existing ARES Power Plan found. Removing it..." -ForegroundColor Yellow
    $existingGuid = ($existingPlan -split '\s+')[3]
    powercfg -delete $existingGuid
}

$planGuid = powercfg -create "ARES Gaming"
Write-Host "Power plan creation output: $planGuid" -ForegroundColor Yellow
if ($planGuid -match '([a-f0-9-]{36})') {
    $planGuid = $matches[1]
    Write-Host "Extracted GUID: $planGuid" -ForegroundColor Green
} else {
    Write-Host "Error: Could not extract GUID. Output: $planGuid" -ForegroundColor Red
    exit 1
}

Write-Host "Activating power plan..." -ForegroundColor Green
powercfg -SetActive $planGuid

switch ($choice) {
    "1" {
        Write-Host "Configuring Gaming preset..." -ForegroundColor Green
        try { powercfg -setacvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMAX 100 } catch {}
        try { powercfg -setdcvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMAX 100 } catch {}
        try { powercfg -setacvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMIN 5 } catch {}
        try { powercfg -setdcvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMIN 5 } catch {}
        try { powercfg -setacvalueindex $planGuid SUB_PROCESSOR SYSCOOLPOLICY 1 } catch {}
        try { powercfg -setdcvalueindex $planGuid SUB_PROCESSOR SYSCOOLPOLICY 1 } catch {}
    }
    "2" {
        Write-Host "Configuring Balanced preset..." -ForegroundColor Green
        try { powercfg -setacvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMAX 100 } catch {}
        try { powercfg -setdcvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMAX 100 } catch {}
        try { powercfg -setacvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMIN 5 } catch {}
        try { powercfg -setdcvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMIN 5 } catch {}
        try { powercfg -setacvalueindex $planGuid SUB_PROCESSOR SYSCOOLPOLICY 0 } catch {}
        try { powercfg -setdcvalueindex $planGuid SUB_PROCESSOR SYSCOOLPOLICY 0 } catch {}
    }
    "3" {
        Write-Host "Configuring Power Saver preset..." -ForegroundColor Green
        try { powercfg -setacvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMAX 80 } catch {}
        try { powercfg -setdcvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMAX 80 } catch {}
        try { powercfg -setacvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMIN 5 } catch {}
        try { powercfg -setdcvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMIN 5 } catch {}
        try { powercfg -setacvalueindex $planGuid SUB_PROCESSOR SYSCOOLPOLICY 0 } catch {}
        try { powercfg -setdcvalueindex $planGuid SUB_PROCESSOR SYSCOOLPOLICY 0 } catch {}
    }
    default {
        Write-Host "Invalid choice. Using Gaming preset." -ForegroundColor Yellow
        try { powercfg -setacvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMAX 100 } catch {}
        try { powercfg -setdcvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMAX 100 } catch {}
        try { powercfg -setacvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMIN 5 } catch {}
        try { powercfg -setdcvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMIN 5 } catch {}
        try { powercfg -setacvalueindex $planGuid SUB_PROCESSOR SYSCOOLPOLICY 1 } catch {}
        try { powercfg -setdcvalueindex $planGuid SUB_PROCESSOR SYSCOOLPOLICY 1 } catch {}
    }
}

try { powercfg -change -monitor-timeout-ac 0 } catch {}
try { powercfg -change -monitor-timeout-dc 0 } catch {}
try { powercfg -change -standby-timeout-ac 0 } catch {}
try { powercfg -change -standby-timeout-dc 0 } catch {}
try { powercfg -change -hibernate-timeout-ac 0 } catch {}
try { powercfg -change -hibernate-timeout-dc 0 } catch {}

try { powercfg -setacvalueindex $planGuid SUB_DISK DISKIDLE 0 } catch {}
try { powercfg -setdcvalueindex $planGuid SUB_DISK DISKIDLE 0 } catch {}

try { powercfg -setacvalueindex $planGuid SUB_PCIEXPRESS ASPM 0 } catch {}
try { powercfg -setdcvalueindex $planGuid SUB_PCIEXPRESS ASPM 0 } catch {}

try { powercfg -setacvalueindex $planGuid SUB_USB USBSELECTIVESUSPEND 0 } catch {}
try { powercfg -setdcvalueindex $planGuid SUB_USB USBSELECTIVESUSPEND 0 } catch {}

try { powercfg -setacvalueindex $planGuid SUB_VIDEO VIDEOIDLE 0 } catch {}
try { powercfg -setdcvalueindex $planGuid SUB_VIDEO VIDEOIDLE 0 } catch {}

try { powercfg -setacvalueindex $planGuid SUB_DISPLAY ADAPTIVEBRIGHTNESS 0 } catch {}
try { powercfg -setdcvalueindex $planGuid SUB_DISPLAY ADAPTIVEBRIGHTNESS 0 } catch {}

try { powercfg -SetActive $planGuid } catch {}

Write-Host ""
Write-Host "ARES Power Plan created and activated successfully!" -ForegroundColor Green
Write-Host "GUID: $planGuid"
