Write-Host "ARES Power Plan Configurator" -ForegroundColor Cyan
Write-Host "============================" -ForegroundColor Cyan
Write-Host ""
Write-Host "Select preset:"
Write-Host "1. Gaming (Maximum Performance)"
Write-Host "2. Balanced"
Write-Host "3. Power Saver"
Write-Host ""

$choice = Read-Host "Enter choice (1-3)"

$existingPlan = powercfg -list | Select-String "ARES"
if ($existingPlan) {
    Write-Host "Existing ARES Power Plan found. Removing it..." -ForegroundColor Yellow
    $existingGuid = ($existingPlan -split '\s+')[3]
    powercfg -delete $existingGuid
}

$planGuid = powercfg -create "ARES"
if ($planGuid -match '([a-f0-9-]{36})') {
    $planGuid = $matches[1]
} else {
    Write-Host "Error: Could not extract GUID. Output: $planGuid" -ForegroundColor Red
    exit 1
}

switch ($choice) {
    "1" {
        Write-Host "Configuring Gaming preset..." -ForegroundColor Green
        powercfg -setacvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMAX 100
        powercfg -setdcvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMAX 100
        powercfg -setacvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMIN 5
        powercfg -setdcvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMIN 5
        powercfg -setacvalueindex $planGuid SUB_PROCESSOR IDLEDISABLE 1
        powercfg -setdcvalueindex $planGuid SUB_PROCESSOR IDLEDISABLE 1
        powercfg -setacvalueindex $planGuid SUB_PROCESSOR PERFBOOST 0
        powercfg -setdcvalueindex $planGuid SUB_PROCESSOR PERFBOOST 0
        powercfg -setacvalueindex $planGuid SUB_PROCESSOR PERFEPP 0
        powercfg -setdcvalueindex $planGuid SUB_PROCESSOR PERFEPP 0
        powercfg -setacvalueindex $planGuid SUB_PROCESSOR LATENCYHINTPERF 1
        powercfg -setdcvalueindex $planGuid SUB_PROCESSOR LATENCYHINTPERF 1
        powercfg -setacvalueindex $planGuid SUB_PROCESSOR SHORTTHREADBOOST 1
        powercfg -setdcvalueindex $planGuid SUB_PROCESSOR SHORTTHREADBOOST 1
        powercfg -setacvalueindex $planGuid SUB_PROCESSOR SYSCOOLPOLICY 1
        powercfg -setdcvalueindex $planGuid SUB_PROCESSOR SYSCOOLPOLICY 1
    }
    "2" {
        Write-Host "Configuring Balanced preset..." -ForegroundColor Green
        powercfg -setacvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMAX 100
        powercfg -setdcvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMAX 100
        powercfg -setacvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMIN 5
        powercfg -setdcvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMIN 5
        powercfg -setacvalueindex $planGuid SUB_PROCESSOR IDLEDISABLE 0
        powercfg -setdcvalueindex $planGuid SUB_PROCESSOR IDLEDISABLE 0
        powercfg -setacvalueindex $planGuid SUB_PROCESSOR PERFBOOST 1
        powercfg -setdcvalueindex $planGuid SUB_PROCESSOR PERFBOOST 1
        powercfg -setacvalueindex $planGuid SUB_PROCESSOR SYSCOOLPOLICY 0
        powercfg -setdcvalueindex $planGuid SUB_PROCESSOR SYSCOOLPOLICY 0
    }
    "3" {
        Write-Host "Configuring Power Saver preset..." -ForegroundColor Green
        powercfg -setacvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMAX 80
        powercfg -setdcvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMAX 80
        powercfg -setacvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMIN 5
        powercfg -setdcvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMIN 5
        powercfg -setacvalueindex $planGuid SUB_PROCESSOR IDLEDISABLE 0
        powercfg -setdcvalueindex $planGuid SUB_PROCESSOR IDLEDISABLE 0
        powercfg -setacvalueindex $planGuid SUB_PROCESSOR PERFBOOST 1
        powercfg -setdcvalueindex $planGuid SUB_PROCESSOR PERFBOOST 1
        powercfg -setacvalueindex $planGuid SUB_PROCESSOR SYSCOOLPOLICY 0
        powercfg -setdcvalueindex $planGuid SUB_PROCESSOR SYSCOOLPOLICY 0
    }
    default {
        Write-Host "Invalid choice. Using Gaming preset." -ForegroundColor Yellow
        powercfg -setacvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMAX 100
        powercfg -setdcvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMAX 100
        powercfg -setacvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMIN 5
        powercfg -setdcvalueindex $planGuid SUB_PROCESSOR PROCTHROTTLEMIN 5
        powercfg -setacvalueindex $planGuid SUB_PROCESSOR IDLEDISABLE 1
        powercfg -setdcvalueindex $planGuid SUB_PROCESSOR IDLEDISABLE 1
    }
}

powercfg -change -monitor-timeout-ac 0
powercfg -change -monitor-timeout-dc 0
powercfg -change -standby-timeout-ac 0
powercfg -change -standby-timeout-dc 0
powercfg -change -hibernate-timeout-ac 0
powercfg -change -hibernate-timeout-dc 0

powercfg -setacvalueindex $planGuid SUB_DISK DISKIDLE 0
powercfg -setdcvalueindex $planGuid SUB_DISK DISKIDLE 0

powercfg -setacvalueindex $planGuid SUB_PCIEXPRESS ASPM 0
powercfg -setdcvalueindex $planGuid SUB_PCIEXPRESS ASPM 0

powercfg -setacvalueindex $planGuid SUB_PCIEXPRESS PCIEXPRESSASPM 0
powercfg -setdcvalueindex $planGuid SUB_PCIEXPRESS PCIEXPRESSASPM 0

powercfg -setacvalueindex $planGuid SUB_USB USBSELECTIVESUSPEND 0
powercfg -setdcvalueindex $planGuid SUB_USB USBSELECTIVESUSPEND 0

powercfg -setacvalueindex $planGuid SUB_VIDEO VIDEOIDLE 0
powercfg -setdcvalueindex $planGuid SUB_VIDEO VIDEOIDLE 0

powercfg -setacvalueindex $planGuid SUB_DISPLAY ADAPTIVEBRIGHTNESS 0
powercfg -setdcvalueindex $planGuid SUB_DISPLAY ADAPTIVEBRIGHTNESS 0

powercfg -SetActive $planGuid

Write-Host ""
Write-Host "ARES Power Plan created and activated successfully!" -ForegroundColor Green
Write-Host "GUID: $planGuid"
